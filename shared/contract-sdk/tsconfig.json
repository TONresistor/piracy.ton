{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "noEmit": true,
    "types": [
      "node"
    ],
    "paths": {
      "@ton/core": [
        "./node_modules/@ton/core"
      ]
    }
  },
  "include": [
    "src/**/*.ts"
  ]
}
