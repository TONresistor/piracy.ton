{
  "name": "piracy-ton-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "npm run build:sdk && node scripts/build.mjs",
    "lint": "eslint .",
    "test": "node --test",
    "check": "npm run build && npm run lint && npm run typecheck && npm test",
    "build:sdk": "npm --prefix ../shared/contract-sdk run build",
    "typecheck": "npm --prefix ../shared/contract-sdk run typecheck"
  },
  "dependencies": {
    "@ton/core": "0.63.1",
    "@ton/crypto": "3.3.0",
    "@tonconnect/ui": "3.0.0",
    "buffer": "6.0.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "esbuild": "0.28.1",
    "eslint": "10.13.0",
    "typescript": "6.0.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
